{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // tsc — только типизация (noEmit). Реальную CommonJS-сборку делает SWC (.swcrc).
    // Поэтому module=ESNext + moduleResolution=Bundler: современный резолвер (node10
    // депрекейтнут и уйдёт в TS 7), бесрасширенные импорты в стиле Nest, чтение exports
    // пакетов. Консистентно с apps/web.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "lib": ["ES2023"],
    // jest — ради глобалей (describe/it/expect) в *.spec.ts. Раннер их не типизирует сам:
    // @swc/jest только транспилирует, проверку типов делает tsc.
    "types": ["node", "jest"],

    // Nest DI держится на метаданных декораторов: нужны и редактору, и typecheck,
    // и SWC (см. .swcrc). Без них DI молча ломается.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // Реэкспорт enum-ов/типов из @slate/database несовместим с isolatedModules —
    // держим выключенным (сборку делает SWC, не tsc).
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": true,
    "outDir": "./dist",
    // rootDir охватывает и src, и test: e2e-тесты импортируют исходники приложения, и без
    // общего корня tsc ругался бы «is not under rootDir». На сборку это не влияет — эмитит
    // не tsc, а SWC по nest-cli.json (sourceRoot: src), и test/ туда не попадает.
    "rootDir": "."

    // @slate/database резолвится как обычный workspace-пакет: его package.json
    // (exports/main/types) указывает на СОБРАННЫЙ CJS-dist. tsconfig paths больше не нужен —
    // и tsc, и SWC (nest build) находят пакет через symlink в node_modules. Раньше paths
    // без baseUrl ронял SWC (base_dir пустой) при первом же импорте пакета в коде.
  },
  // test/** включён намеренно: иначе e2e-файлы не типизируются ни tsc, ни type-aware
  // правилами ESLint (projectService ищет tsconfig, который их включает), и ошибки в них
  // всплывали бы только в рантайме прогона.
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
