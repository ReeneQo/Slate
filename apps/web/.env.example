# Слейт — фронт (Vite). Скопируй в .env.local: `cp .env.example .env.local`.
# В бандл попадают ТОЛЬКО переменные с префиксом VITE_ (правило Vite) — секретов здесь не держим.

# ── API ───────────────────────────────────────────────────────────────────────
# Базовый URL бэкенда, ВКЛЮЧАЯ префикс /api (бэк слушает setGlobalPrefix('api')).
# Dev: Vite (5173) ходит кросс-origin в Nest (3000) — нужен полный абсолютный URL.
# Prod за reverse-proxy (same-origin): оставь пустым или '/api' — запрос уйдёт на текущий origin.
VITE_API_URL=http://localhost:3000/api
