    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
