{
  "name": "@slate/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Slate frontend (Vite + React, FSD).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.6.0",
    "@slate/shared-types": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "immer": "^11.1.8",
    "konva": "^10.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.84.0",
    "react-konva": "^19.2.5",
    "react-router": "^8.3.0",
    "socket.io-client": "^4.8.3",
    "uuid": "^11.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
