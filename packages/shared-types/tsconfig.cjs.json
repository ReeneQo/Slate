{
  // CJS-сборка для apps/api: Nest компилируется SWC в CommonJS и делает require() пакета.
  // Без этого выхлопа импорт падал бы в рантайме с ERR_REQUIRE_ESM — при зелёном typecheck,
  // потому что типы приходят из src и о формате модулей ничего не сообщают.
  //
  // moduleResolution=node10 (а не Bundler) — вынужденно: Bundler совместим только с
  // module=ESNext/Preserve. Для зависимостей это безопасно, у zod есть и "main", и "types".
  "extends": "./tsconfig.esm.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node10",
    "outDir": "./dist/cjs"
  }
}
