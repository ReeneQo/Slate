{
  // ESM-сборка для apps/web (Vite резолвит условие "import").
  //
  // Относительные импорты в src написаны с расширением `.js` — без него выхлоп был бы
  // невалидным ESM для Node (там расширение обязательно). Бандлеру всё равно, Node — нет,
  // а платить за это приходится один раз при написании импорта.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist/esm"
  },
  // Тесты в дистрибутив не попадают: они проверяют пакет, а не входят в него. Плюс vitest
  // подобрал бы их скомпилированные копии в dist и прогнал те же кейсы ещё дважды.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
