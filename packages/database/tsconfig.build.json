{
  // Build-конфиг: компилирует src + сгенерированный клиент в dist (CommonJS).
  // Отдельный от tsconfig.json (тот — typecheck исходников, noEmit, generated исключён).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],

    // Клиент Prisma 7 генерится в CJS (schema.prisma: moduleFormat="cjs"), пакет —
    // "type": "commonjs". NodeNext при type=commonjs эмитит require/exports.
    // Импорты в клиенте с '.js' (importFileExtension="js") NodeNext резолвит в '.ts'
    // на входе и оставляет '.js' в выхлопе — спец-флаги для '.ts'-импортов не нужны.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["src/**/*", "generated/**/*"],
  "exclude": ["node_modules", "dist"]
}
