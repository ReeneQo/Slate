# Слейт — переменные окружения. Скопируй в .env: `cp .env.example .env`.
# Инфраструктурные dev-значения — РЕАЛЬНЫЕ рабочие (не плейсхолдеры): контейнеры слушают
# localhost, эти креды ничего внешнего не защищают. Крипто-секреты — плейсхолдеры (см. ниже).

# ── Postgres (docker-compose) ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=slate_dev
# Хост-порт (контейнер всегда 5432). Сдвинут, чтобы не конфликтовать с локальным Postgres.
POSTGRES_PORT=5434

# ── Redis (docker-compose) ────────────────────────────────────────────────────
# Хост-порт (контейнер всегда 6379). Сдвинут, чтобы не конфликтовать с локальным Redis.
REDIS_PORT=6381

# ── Строки подключения (согласованы с портами/кредами выше) ───────────────────
# Prisma/api подключаются с ХОСТА → порт 5434 (проброшенный), не 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/slate_dev?schema=public
# Формат с поддержкой пароля (redis://:PASSWORD@host:port); локально пароля нет.
REDIS_URL=redis://localhost:6381

# ── API (NestJS) ──────────────────────────────────────────────────────────────
# Порт бэкенда. Именно API_PORT (не PORT) — чтобы не коллидировать с Vite (5173).
# TODO(SLT-12): переедет в валидированный zod-config.
API_PORT=3000
# Origin фронта для CORS (credentials: true — под куки-сессии блока 2). Локальный Vite.
ALLOWED_ORIGIN=http://localhost:5173
# Число доверенных reverse-proxy перед бэком (Express `trust proxy`). В деве прямое
# соединение без прокси → 0 (X-Forwarded-For не доверяем). В проде за балансировщиком,
# терминирующим TLS, — число хопов (обычно 1); иначе ломаются secure-куки и rate-limit по IP.
# Дефолт при отсутствии переменной — 1.
TRUST_PROXY=0

# ── Сессии (Redis-store, блок 2) ──────────────────────────────────────────────
# Ключ подписи session-id. ПУСТО НАМЕРЕННО — рабочего значения здесь не будет.
# Сгенерируй своё и положи в .env:  openssl rand -base64 32
# Минимум 32 символа, иначе конфиг не пройдёт валидацию и сервер не стартует.
SESSION_SECRET=

# Имя cookie. Своё, а не дефолтное connect.sid: дефолт выдаёт стек сканеру.
SESSION_NAME=slate.sid

# TTL сессии (столько же живут кука и запись в Redis). Человекочитаемый формат
# <число><ms|s|m|h|d>, например 7d / 24h / 30m / 3600s / 500ms.
SESSION_MAX_AGE=7d

# Домен cookie. В деве НЕ задаём — браузер сам привяжет её к localhost, а явный
# domain=localhost часть браузеров отвергает. В проде — общий домен под сабдомены
# (например .slate.app для api.slate.app + app.slate.app).
# SESSION_DOMAIN=

# httpOnly, secure и префикс ключей в env НЕ выносим: httpOnly=true и sameSite=lax
# захардкожены, secure выводится из NODE_ENV (в проде — true). Флаг в env создавал бы
# ровно две тихие аварии: забыли в проде (кука по HTTP) или включили в деве (браузер
# молча отбрасывает secure-куку на http://localhost).
